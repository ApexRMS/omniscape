<?xml version="1.0" encoding="utf-8" ?>
<update comment="Update to omniscape 2.8 that adds ensemble connectivity, quantile-based categorization, and resistance modifier rescaling">

    <!-- Record the break values actually used for each connectivity category.
         In Value mode these repeat the Category Thresholds; in the new Quantile
         mode they are computed from the run's own distribution, and are the only
         record of what the requested quantiles worked out to. -->
    <action code="Exec" condition="TableExists" criteria="omniscape_outputTabularReclassification">
        <item>ALTER TABLE omniscape_outputTabularReclassification ADD COLUMN minBreakValue DOUBLE</item>
        <item>ALTER TABLE omniscape_outputTabularReclassification ADD COLUMN maxBreakValue DOUBLE</item>
    </action>

    <!-- The category coverage figure has always been stored as a proportion
         between 0 and 1, not as a percentage. Renaming the column and its chart
         variable makes the label match the value, leaving existing results
         untouched. -->
    <action code="RenameColumn" tableName="omniscape_outputTabularReclassification" oldColumnName="percentCover" newColumnName="proportionCover">
    </action>

    <action code="RenameChartVariable" oldVariableName="outputTabularReclassificationPercentCover" newVariableName="outputTabularReclassificationProportionCover">
    </action>

    <!-- Controls how a modified resistance surface is brought back to the
         largest value in the Reclass Table, now that resistance modifiers are
         applied after reclassification and so scale real resistance values
         rather than land cover class IDs. 0 is Exact, which is the behaviour
         every existing Scenario already has, so leaving the column null
         changes nothing. -->
    <action code="Exec" condition="TableExists" criteria="omniscape_ResistanceModifierOptions">
        <item>ALTER TABLE omniscape_ResistanceModifierOptions ADD COLUMN rescaling INTEGER</item>
    </action>

</update>
